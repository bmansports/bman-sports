---
interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the poll graphic) opt out of the centered column. */
  wide?: boolean;
}

const { title, description = "", wide = false } = Astro.props;

const nav = [
  { href: "/rankings/", label: "Rankings" },
  { href: "/matchups/", label: "Matchups" },
  { href: "/blog/", label: "Blog" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <slot name="head" />
</head>
<body>
  <header class="site-head">
    <a class="brand" href="/">Bman's Sports</a>
    <nav>
      {nav.map((item) => (
        <a href={item.href} class={isActive(item.href) ? "on" : ""}>
          {item.label}
        </a>
      ))}
    </nav>
  </header>

  <main class={wide ? "wide" : ""}>
    <slot />
  </main>

  <footer class="site-foot">
    <p>Rankings and opinions are my own.</p>
  </footer>

  <style is:global>
    :root{
      --field:#1E2732;
      --surface:#27323F;
      --rule:#3A4757;
      --ink:#F0F3F6;
      --muted:#93A2B0;
      --flat:#5D6D7C;
      --up:#5FB474;
      --down:#DD6E63;
      --new:#D2AC33;
      --page:#0B0F13;
    }
    *{box-sizing:border-box}
    body{
      margin:0;background:var(--page);color:var(--ink);
      font-family:'Barlow',system-ui,sans-serif;
      display:flex;flex-direction:column;min-height:100vh;
    }
    a{color:inherit}

    .site-head{
      display:flex;align-items:baseline;justify-content:space-between;
      gap:24px;flex-wrap:wrap;
      max-width:1080px;width:100%;margin:0 auto;
      padding:24px 24px 20px;
      border-bottom:1px solid var(--rule);
    }
    .brand{
      font-family:'Barlow Condensed',sans-serif;
      font-weight:700;font-size:26px;letter-spacing:-.01em;
      text-decoration:none;
    }
    .site-head nav{display:flex;gap:22px}
    .site-head nav a{
      font-size:14px;font-weight:500;color:var(--muted);
      text-decoration:none;padding-bottom:2px;
      border-bottom:2px solid transparent;
    }
    .site-head nav a:hover{color:var(--ink)}
    .site-head nav a.on{color:var(--ink);border-bottom-color:var(--ink)}

    main{
      flex:1 1 auto;width:100%;
      max-width:1080px;margin:0 auto;padding:44px 24px 72px;
    }
    main.wide{max-width:none;padding:32px 16px 64px;display:flex;
      flex-direction:column;align-items:center;gap:20px}

    .site-foot{
      border-top:1px solid var(--rule);
      max-width:1080px;width:100%;margin:0 auto;
      padding:20px 24px 40px;
      font-size:12px;color:var(--flat);
    }
    .site-foot p{margin:0}

    h1,h2,h3{font-family:'Barlow Condensed',sans-serif;letter-spacing:-.01em;margin:0}
    .page-title{font-weight:700;font-size:46px;line-height:.95}
    .lede{color:var(--muted);margin:10px 0 0;font-size:16px;max-width:60ch}
  </style>
</body>
</html>

---
import { getCollection } from "astro:content";
import PollGraphic from "../../components/PollGraphic.astro";
import { buildBoard, type Poll, type Team } from "../../lib/poll";

export async function getStaticPaths() {
  const polls = await getCollection("cfbPoll");
  const byId = new Map(polls.map((p) => [p.id, p]));

  return polls.map((entry) => {
    // "previous" names a filename; collection ids drop the extension.
    const prevId = entry.data.previous
      ? entry.data.previous.replace(/\.json$/, "")
      : null;
    const prev = prevId ? byId.get(prevId) : undefined;

    return {
      params: { week: entry.id },
      props: {
        poll: entry.data as Poll,
        prevPoll: (prev ? prev.data : null) as Poll | null,
      },
    };
  });
}

const { poll, prevPoll } = Astro.props;

const teamEntries = await getCollection("teams");
const teams = new Map<string, Team>(
  teamEntries.map((t) => [t.id, t.data as Team])
);

const board = buildBoard(teams, poll, prevPoll);
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{poll.title} — {poll.week}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</head>
<body>
  <PollGraphic board={board} poll={poll} />

  <div class="controls">
    <a href="/">← All polls</a>
    <label for="scale">Export size</label>
    <select id="scale">
      <option value="2" selected>2000px wide (2x)</option>
      <option value="3">3000px wide (3x)</option>
    </select>
    <button id="save" data-name={`${poll.title} ${poll.week}`}>Download PNG</button>
  </div>

  <script is:inline>
    function imagesSettled(root){
      return Promise.all([...root.querySelectorAll("img")].map(img =>
        img.complete ? null : new Promise(done => {
          img.addEventListener("load", done, { once:true });
          img.addEventListener("error", done, { once:true });
        })
      ));
    }

    function slugify(s){
      return String(s).toLowerCase()
        .replace(/['\u2019]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    const saveBtn = document.getElementById("save");
    saveBtn.addEventListener("click", async () => {
      saveBtn.disabled = true;
      const original = saveBtn.textContent;
      saveBtn.textContent = "Rendering\u2026";
      try {
        const poster = document.getElementById("poster");
        await document.fonts.ready;
        await imagesSettled(poster);
        const scale = Number(document.getElementById("scale").value);
        const canvas = await html2canvas(poster, {
          scale,
          useCORS: true,
          backgroundColor: getComputedStyle(poster).backgroundColor
        });
        const a = document.createElement("a");
        a.download = slugify(saveBtn.dataset.name) + ".png";
        a.href = canvas.toDataURL("image/png");
        a.click();
        saveBtn.textContent = "Downloaded";
        setTimeout(() => { saveBtn.textContent = original; }, 1600);
      } catch (e) {
        console.error(e);
        saveBtn.textContent = "Export failed \u2014 see console";
      } finally {
        saveBtn.disabled = false;
      }
    });
  </script>

  <style>
    body{
      background:#0B0F13;
      font-family:'Barlow',system-ui,sans-serif;
      min-height:100vh;margin:0;
      display:flex;flex-direction:column;align-items:center;
      padding:32px 16px 64px;gap:20px;
    }
    .controls{display:flex;gap:12px;align-items:center;font-size:14px;color:#8A98A5}
    .controls a{color:#8A98A5;text-decoration:none;margin-right:8px}
    .controls a:hover{color:#F0F3F6}
    button{
      font:inherit;font-weight:600;color:#0B0F13;background:#EDF1F4;
      border:0;padding:10px 18px;cursor:pointer;
    }
    button:focus-visible{outline:2px solid #5FB474;outline-offset:2px}
    button[disabled]{opacity:.5;cursor:wait}
    select{font:inherit;padding:9px 10px;background:#27323F;color:#F0F3F6;border:1px solid #3A4757}
  </style>
</body>
</html>

---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<Base title={`${post.data.title} — Bman's Sports`} description={post.data.summary}>
  <p class="crumb"><a href="/blog/">← All posts</a></p>

  <article>
    <h1 class="page-title">{post.data.title}</h1>
    <p class="dt">{fmt(post.data.date)}</p>
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .crumb{margin:0 0 14px;font-size:13px}
  .crumb a{color:var(--muted);text-decoration:none}
  .crumb a:hover{color:var(--ink)}

  article{max-width:68ch}
  .dt{margin:10px 0 0;font-size:13px;color:var(--flat)}

  .body{margin-top:32px;font-size:17px;line-height:1.65}
  .body :global(p){margin:0 0 20px}
  .body :global(h2){
    font-weight:600;font-size:30px;margin:38px 0 12px;
  }
  .body :global(h3){
    font-weight:600;font-size:23px;margin:30px 0 10px;
  }
  .body :global(ul),.body :global(ol){margin:0 0 20px;padding-left:22px}
  .body :global(li){margin-bottom:8px}
  .body :global(a){color:var(--new)}
  .body :global(blockquote){
    margin:0 0 20px;padding-left:18px;
    border-left:3px solid var(--rule);color:var(--muted);
  }
  .body :global(code){
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size:.88em;background:var(--field);padding:2px 6px;
  }
  .body :global(pre){
    background:var(--field);border:1px solid var(--rule);
    padding:16px 18px;overflow-x:auto;margin:0 0 20px;
  }
  .body :global(pre code){background:none;padding:0}
  .body :global(img){max-width:100%;height:auto}
  .body :global(hr){border:0;border-top:1px solid var(--rule);margin:32px 0}
</style>

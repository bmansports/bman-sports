---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const [polls, teamEntries] = await Promise.all([
  getCollection("cfbPoll"),
  getCollection("teams"),
]);

const teams = new Map(teamEntries.map((t) => [t.id, t.data]));
const latest = polls.sort((a, b) => b.id.localeCompare(a.id))[0];

const topFive = latest
  ? latest.data.rankings.slice(0, 5).map((r, i) => {
      const id = typeof r.team === "string" ? r.team : r.team.id;
      return { id, rank: i + 1, name: teams.get(id)?.name ?? id };
    })
  : [];

const sections = [
  {
    href: "/rankings/",
    label: "Rankings",
    blurb: "My Top 25, updated every week, with movement tracked against the previous poll.",
  },
  {
    href: "/matchups/",
    label: "Marquee matchups",
    blurb: "The handful of games each week that actually decide something.",
  },
  {
    href: "/blog/",
    label: "Blog",
    blurb: "Longer arguments about the rankings, and notes on how this site is built.",
  },
];
---

<Base title="Bman's Sports" description="Weekly college football rankings, marquee matchups, and analysis.">
  <h1 class="page-title">Bman's Sports</h1>
  <p class="lede">
    A weekly college football Top 25, the games worth watching, and the
    occasional argument about both.
  </p>

  {latest && (
    <a class="latest" href={`/cfb/${latest.id}/`}>
      <div class="latest-head">
        <span class="tag">Latest poll</span>
        <span class="wk">{latest.data.week}</span>
        <span class="dt">{latest.data.date}</span>
      </div>
      <ol class="five">
        {topFive.map((t) => (
          <li>
            <span class="n">{t.rank}</span>
            <img src={`/logos/${t.id}.png`} alt="" />
            <span class="nm">{t.name}</span>
          </li>
        ))}
      </ol>
    </a>
  )}

  <div class="sections">
    {sections.map((s) => (
      <a class="section" href={s.href}>
        <h2>{s.label}</h2>
        <p>{s.blurb}</p>
      </a>
    ))}
  </div>
</Base>

<style>
  .latest{
    display:block;text-decoration:none;
    margin:40px 0 44px;padding:22px 24px 24px;
    background:var(--field);border:1px solid var(--rule);
  }
  .latest:hover{border-color:var(--muted)}
  .latest-head{
    display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;
    padding-bottom:18px;border-bottom:1px solid var(--rule);
  }
  .tag{
    font-size:11px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--new);
  }
  .wk{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:600;font-size:22px;text-transform:uppercase;
  }
  .dt{font-size:13px;color:var(--muted);margin-left:auto}

  .five{list-style:none;margin:0;padding:18px 0 0;display:flex;gap:8px}
  .five li{
    flex:1 1 0;min-width:0;
    display:flex;flex-direction:column;align-items:center;gap:8px;
    text-align:center;
  }
  .five .n{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:600;font-size:16px;color:var(--muted);
    font-variant-numeric:tabular-nums;
  }
  .five img{height:38px;max-width:52px;object-fit:contain}
  .five .nm{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:600;font-size:15px;text-transform:uppercase;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;
  }

  .sections{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .section{
    display:block;text-decoration:none;
    padding:22px;background:var(--field);
    border:1px solid var(--rule);
  }
  .section:hover{border-color:var(--muted)}
  .section h2{font-weight:600;font-size:24px;text-transform:uppercase}
  .section p{margin:8px 0 0;font-size:14px;color:var(--muted);line-height:1.5}

  @media (max-width:760px){
    .sections{grid-template-columns:1fr}
    .five{flex-wrap:wrap}
    .five li{flex:0 0 calc(33.333% - 6px)}
  }
</style>
